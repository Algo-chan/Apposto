# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# "sheets" (real) or "memory" (demo, data lost on restart)
STORAGE=sheets

# The long id in your sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Path to the service-account JSON key you downloaded from Google Cloud
GOOGLE_CREDENTIALS_FILE=./google-key.json

# Dispatch group (you + riders). Add the bot to the group and send /myid there. Group ids start with -100
DISPATCH_CHAT_ID=
# Your Telegram id (and co-founders), comma separated. Send /myid to the bot in private.
ADMIN_IDS=123456789
SUPPORT_PHONE=09XXXXXXXX
BRAND_NAME=Apposto

# ---- Money (birr) ----
DELIVERY_FEE_BASE=30
BASE_KM=1
PER_KM_FEE=10
# Bicycles: refuse orders further than this (estimated road km)
MAX_KM=4
# Straight-line distance x this = estimated road distance
ROAD_FACTOR=1.3
SERVICE_FEE=10
# % of the delivery fee that goes to the rider
RIDER_SHARE_PCT=75
# Used when a merchant row has no commission_pct
DEFAULT_COMMISSION_PCT=8

# How long (seconds) merchant/menu/rider edits in the sheet take to show up (or use /reload)
CACHE_SECONDS=60

# ---- Delivery time estimate (minutes) ----
# Used until a shop has 5+ orders; after that the bot learns each shop's real prep time
DEFAULT_PREP_MIN=20
# Rider getting to the shop
PICKUP_MIN=5
# Bicycle in town: ~4-5 minutes per km
RIDE_MIN_PER_KM=4.5
ETA_BUFFER_MIN=5
# Used when the customer skipped sharing location
DEFAULT_DISTANCE_KM=2

# ---- Ratings ----
# A shop's star rating is shown only after this many reviews (fair to new shops)
MIN_REVIEWS_TO_SHOW=5

# ---- Demo mode only (STORAGE=memory) ----
# Put your own Telegram id to play the merchant and/or rider yourself
DEMO_MERCHANT_TELEGRAM_ID=
DEMO_RIDER_TELEGRAM_ID=
